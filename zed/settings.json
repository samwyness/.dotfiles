// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "agent_servers": {
    "claude": {
      "default_mode": "plan"
    }
  },
  "outline_panel": {
    "dock": "right"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "buffer_font_family": "Menlo",
  "buffer_font_size": 14.0,
  "ui_font_size": 16,
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": false,
    "show_parameter_hints": true,
    "show_other_hints": true
  },
  "theme": "Rosé Pine",
  "theme_overrides": {
    "Rosé Pine": {
      "vim.mode.text": "#494d64",
      "vim.normal.background": "#8aadf4",
      "vim.insert.background": "#a6da95",
      "vim.visual.background": "#c6a0f6",
      "vim.visual_line.background": "#c6a0f6",
      "vim.visual_block.background": "#c6a0f6",
      "vim.replace.background": "#ed8796"
    }
  },
  "icon_theme": "Catppuccin Mocha",
  "features": {
    "edit_prediction_provider": "zed"
  },
  "project_panel": {
    "dock": "right",
    "default_width": 360
  },
  "agent": {
    "dock": "right",
    "model_parameters": []
  },
  "git_panel": {
    "sort_by_path": false,
    "tree_view": false,
    "button": true,
    "dock": "right",
    "default_width": 360
  },
  "tabs": {
    "file_icons": true,
    "git_status": true
  },
  "preview_tabs": {
    "enable_preview_from_file_finder": true
  },
  "file_types": {
    "Shell Script": ["**.env.*", "**.env"],
    "C++": ["mm", "m"]
  },
  "format_on_save": "on",
  "formatter": "prettier",
  "code_actions_on_format": {
    "source.fixAll.eslint": true
  }
}
